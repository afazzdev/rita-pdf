{
  "name": "rita-pdf",
  "version": "0.1.0",
  "description": "Binds a directory of Markdown docs into a single typeset PDF handbook \u2014 cover, table of contents with real page numbers, mermaid diagrams, and syntax-highlighted code.",
  "keywords": [
    "markdown",
    "pdf",
    "documentation",
    "handbook",
    "mermaid",
    "puppeteer",
    "print"
  ],
  "license": "MIT",
  "author": "afazzdev",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "rita-pdf": "bin/rita-pdf.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./style.css": "./assets/style.css"
  },
  "files": [
    "bin",
    "src",
    "types",
    "assets",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:example": "node bin/rita-pdf.mjs --config examples/rita.config.mjs",
    "prepare": "husky || true",
    "typecheck": "tsc",
    "prepublishOnly": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.2.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.4.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afazzdev/rita-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/afazzdev/rita-pdf/issues"
  },
  "homepage": "https://github.com/afazzdev/rita-pdf#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{mjs,js}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml}": [
      "prettier --write"
    ]
  },
  "types": "./types/src/index.d.mts"
}
